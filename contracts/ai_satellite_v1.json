{
  "schema_version": 1,
  "wire_format": "AI1|TYPE|request_id|payload\\n",
  "max_frame_bytes": 180,
  "type_pattern": "[A-Z_]{1,16}",
  "request_id_min": 1,
  "request_id_max": 4294967295,
  "payload_forbidden": [
    "|",
    "\\r",
    "\\n",
    "\\u0000"
  ],
  "transport": [
    "ble",
    "wifi",
    "usb_future"
  ],
  "messages": [
    {
      "type": "PING",
      "fields": [
        "request_id"
      ]
    },
    {
      "type": "STATUS",
      "fields": [
        "request_id"
      ]
    },
    {
      "type": "ASK",
      "fields": [
        "request_id",
        "payload"
      ]
    },
    {
      "type": "ANSWER",
      "fields": [
        "request_id",
        "payload"
      ]
    }
  ],
  "security": {
    "secrets_on_flipper": false,
    "github_tokens_on_flipper": false,
    "write_operations_require_consent": true
  },
  "source_references": [
    "Flipper-AI-Momentum-:flipper_app/satellite_protocol/ai_wire.c",
    "Flipper-AI-Android-Satellite:android_satellite/app/src/main/java/com/flipperai/satellite/SatelliteProtocol.java"
  ],
  "note": "AI1 request IDs must be nonzero on both Momentum and Android. Source contract only; no BLE hardware interoperability implied."
}
